# Pooled PostgreSQL URL for application queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER:5432/DATABASE?sslmode=require"
# Direct PostgreSQL URL used by Prisma migrations (Vercel Prisma integration)
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_USERNAME=choose_a_username
ADMIN_PASSWORD=use_a_long_random_password
